  "dependencies": {
    "@tailwindcss/cli": "^4.3.2",
    "esbuild": "^0.28.1",
    "htmx.org": "^2.0.10",
    "lucide": "^1.24.0",
    "tailwindcss": "^4.3.2"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.5.6",
    "nodemon": "^3.1.11",
    "concurrently": "^10.0.3"
