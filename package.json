{
  "name": "fasthtmx",
  "version": "0.2.0",
  "type": "module",
  "packageManager": "pnpm@11.15.1+sha512.81350b07e53c9538a02f1f2303b4290fa2d7be04e56e2a970c4cc4b417dc761de196edabd49d55c7dc9580db81007c44143e4e3d7e462b3000d23c255122d065",
  "dependencies": {
    "@alpinejs/collapse": "^3.15.8",
    "@alpinejs/focus": "^3.15.2",
    "@alpinejs/mask": "^3.15.8",
    "@alpinejs/persist": "^3.15.2",
    "@tailwindcss/cli": "^4.1.17",
    "alpinejs": "^3.15.2",
    "concurrently": "^9.2.1",
    "daisyui": "^5.5.5",
    "esbuild": "^0.27.0",
    "fast-glob": "^3.3.3",
    "htmx.org": "^2.0.8",
    "lucide": "^0.555.0",
    "tailwindcss": "^4.1.17"
  },
  "scripts": {
    "build": "concurrently --raw \"pnpm run build:css\" \"pnpm run build:js\"",
    "build:css": "tailwindcss -i ./src/static/css/app.css -o ./src/dist/css/app.css --minify",
    "build:js": "node esbuild.config.js --minify",
    "build:dev": "concurrently --raw \"pnpm run build:dev:css\" \"pnpm run build:dev:js\"",
    "build:dev:css": "tailwindcss -i ./src/static/css/app.css -o ./src/dist/css/app.css",
    "build:dev:js": "node esbuild.config.js --dev",
    "watch": "concurrently -n \"css,js\" -c \"blue,magenta\" \"pnpm run watch:css\" \"pnpm run watch:js\"",
    "watch:css": "tailwindcss -i ./src/static/css/app.css -o ./src/dist/css/app.css --watch",
    "watch:js": "node esbuild.config.js --watch",
    "dev": "pnpm run watch"
  },
  "devDependencies": {
    "@parcel/watcher": "^2.5.6"
  }
}
