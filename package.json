{
  "name": "fasthtmx",
  "version": "1.0.0",
  "description": "",
  "main": "index.js",
  "scripts": {
    "build.css": "tailwindcss -i ./src/static/css/main.css -o ./src/static/dist/css/main.css",
    "build.js": "node esbuild.config.js",
    "watch.js": "node esbuild.config.js --watch",
    "dev": "concurrently --raw \"pnpm run watch.css\" \"pnpm run watch.js\"",
    "watch.css": "tailwindcss -i ./src/static/css/main.css -o ./src/static/dist/css/main.css --watch",
    "watch.css.nodemon": "nodemon --watch ./src/static/css --ext css --exec \"pnpm run build.css\""
  },
